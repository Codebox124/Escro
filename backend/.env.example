# Copy to backend/.env for local development, and set the same variables in your
# backend host's dashboard (Render / Railway / etc.) for production.

# Most hosts set PORT for you. Locally, 5000 is taken by Windows on some machines — use 5050.
PORT=5050
NODE_ENV=development

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Long random string used to sign login tokens (keep the same value across deploys)
JWT_SECRET=
JWT_EXPIRE=7d

# Allowed frontend origin(s), comma-separated, no trailing slash
FRONTEND_URL=http://localhost:3000

# Optional
RATE_LIMIT_MAX=1500
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
